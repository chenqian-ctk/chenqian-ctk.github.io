---
// 小人图 + 整图跟随鼠标动效（整张图朝鼠标方向轻微倾斜/位移，模拟“在看你”的感觉）
---
<div class="character-stage">
  <div class="char-glow"></div>
  <div class="char-float">
    <img
      class="character-img"
      src="/character.png"
      alt="我的卡通小人"
      width="606"
      height="630"
      loading="eager"
    />
  </div>
</div>

<script>
  const img = document.querySelector('.character-img');
  if (img) {
    let tx = 0, ty = 0, rx = 0, ry = 0;   // 当前值
    let ttx = 0, tty = 0, trx = 0, try_ = 0; // 目标值

    window.addEventListener('mousemove', (e) => {
      const nx = (e.clientX / window.innerWidth) * 2 - 1;   // -1 .. 1
      const ny = (e.clientY / window.innerHeight) * 2 - 1;  // -1 .. 1
      ttx = nx * 16;   // 水平位移
      tty = ny * 12;   // 垂直位移
      try_ = nx * 7;   // 左右倾斜
      trx = -ny * 5;   // 上下倾斜
    });

    const loop = () => {
      tx += (ttx - tx) * 0.07;
      ty += (tty - ty) * 0.07;
      rx += (trx - rx) * 0.07;
      ry += (try_ - ry) * 0.07;
      img.style.transform =
        `translate3d(${tx}px, ${ty}px, 0) rotateX(${rx}deg) rotateY(${ry}deg)`;
      requestAnimationFrame(loop);
    };
    loop();
  }
</script>
